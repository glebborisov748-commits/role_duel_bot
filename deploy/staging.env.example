# Copy outside git to .env.staging. Never use the production bot token here.
RD_DEPLOYMENT=staging
STAGING_BOT_TOKEN=
STAGING_WEBAPP_URL=https://staging.example.com
STAGING_DATA_DIR=/app/data-staging
WEBAPP_PORT=8081
# Optional additional testers: comma-separated Telegram IDs. Chief admin is always allowed.
STAGING_TESTER_IDS=
# AI calls use this account and are billable; Telegram invoice creation is blocked in staging.
PROVOD_API_KEY=
AI_MODEL=
INTIM_MODEL=
